# Copy to .env and fill in. `.env` is gitignored; never commit real keys.

# --- LLM tier (Stage 2.3 extraction, Stage 1 choice, Stage 6 description) ---
# Pick one provider. With none configured the tier is disabled and the pipeline
# runs rules + tables only, which is the reported headline configuration.
SOURCED_LLM_PROVIDER=            # anthropic | featherless

# doc 03's provider: typed tool calls and explicit prefix caching.
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint serving open weights.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Leave blank to take the provider default.
SOURCED_LLM_MODEL=
# doc 03 2.4 specifies 3 self-consistency samples on numerics.
SOURCED_SELF_CONSISTENCY_N=3

# --- Store ---
# Default is local SQLite; point at Postgres to use the DDL in migrations/.
SOURCED_DB_URL=sqlite:///data/sourced.db
# SOURCED_DB_URL=postgresql+psycopg://sourced:sourced@localhost:5432/sourced

# --- Real corpus path (doc 05). Absent -> the synthetic generator is used. ---
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
